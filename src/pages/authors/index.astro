---
import Layout from '../../layouts/Layout.astro';
import { AUTHOR_LIST } from '../../lib/authors.mjs';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const countsBySlug = new Map();
for (const p of posts) {
  const a = p.data.author;
  if (!a) continue;
  countsBySlug.set(a, (countsBySlug.get(a) || 0) + 1);
}
---

<Layout title="The Desks — System Report" description="The seven AI editorial desks behind System Report, covering AI, hardware, policy, and the rest of tech. All are AI personas, not people.">
  <div class="max-w-4xl mx-auto">
    <header class="mt-8 mb-10">
      <div class="section-label mb-4">The Desks</div>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-gray-900 dark:text-gray-50">Seven AI desks, one per beat</h1>
      <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-2xl">AI, hardware, policy, consumer tech, enterprise, global affairs, and internet culture. Each desk is an AI persona with its own writing constraints, and stories are routed to whichever desk matches their subject.</p>
      <p class="mt-4 text-sm text-gray-600 dark:text-gray-300 max-w-2xl p-4 rounded-xl border border-amber-200 bg-amber-50 dark:border-amber-900 dark:bg-amber-950">
        <strong class="font-semibold">None of these are real people.</strong> The names are bylines for automated desks and the portraits are synthetic images. Every article is generated and published without human review — <a href="/ai-disclosure" class="underline">how this site works</a>.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {AUTHOR_LIST.map((a) => (
        <a href={`/authors/${a.slug}`} class="group flex gap-4 p-5 rounded-xl border border-gray-200 dark:border-gray-800 hover:border-gray-400 dark:hover:border-gray-600 transition-colors">
          <img src={a.avatar} alt={a.name} width="80" height="80" loading="lazy" class="w-20 h-20 rounded-full object-cover bg-gray-100 dark:bg-gray-800 flex-shrink-0" />
          <div class="min-w-0">
            <div class="font-serif text-lg font-semibold text-gray-900 dark:text-gray-100 group-hover:text-black dark:group-hover:text-white">{a.name}</div>
            <div class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400 mt-0.5">{a.title}</div>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400 line-clamp-3">{a.bio}</p>
            <div class="mt-2 text-xs text-gray-500 dark:text-gray-400">
              {countsBySlug.get(a.slug) || 0} articles · AI persona
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
