---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { tagSlug } from '../../lib/tags';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');

  // Group tags by URL slug. Distinct tags can share a slug once slashes are
  // collapsed, so each page serves every tag that maps to it rather than
  // emitting duplicate paths for the same URL.
  const bySlug = new Map<string, { label: string; tags: Set<string> }>();
  for (const post of allPosts) {
    for (const tag of post.data.tags ?? []) {
      const slug = tagSlug(tag);
      const existing = bySlug.get(slug);
      if (existing) existing.tags.add(tag);
      else bySlug.set(slug, { label: tag, tags: new Set([tag]) });
    }
  }

  return Array.from(bySlug, ([slug, { label, tags }]) => {
    const filteredPosts = allPosts
      .filter((post) => post.data.tags?.some((t) => tags.has(t)))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    return {
      params: { tag: slug },
      props: { tag: label, posts: filteredPosts },
    };
  });
}

const { tag, posts } = Astro.props;
---

<Layout title={`${tag} — System Report`} description={`Articles tagged "${tag}" on System Report.`}>
  <section>
    <nav class="text-sm text-gray-500 dark:text-gray-400 mb-4">
      <a href="/" class="hover:text-black dark:hover:text-white transition-colors">Home</a>
      <span class="mx-2 text-gray-300 dark:text-gray-600">/</span>
      <a href="/tags" class="hover:text-black dark:hover:text-white transition-colors">Tags</a>
      <span class="mx-2 text-gray-300 dark:text-gray-600">/</span>
      <span class="text-gray-900 dark:text-gray-100">{tag}</span>
    </nav>

    <div class="flex items-center gap-3 mb-8">
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-gray-900 dark:text-gray-100">
        {tag}
      </h1>
      <span class="px-3 py-1 bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400 rounded-full text-sm font-medium">
        {posts.length} {posts.length === 1 ? 'article' : 'articles'}
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post: any, i: number) => (
        <div class:list={[`stagger-${(i % 12) + 1}`]}>
          <ArticleCard
            title={post.data.title}
            slug={post.id}
            date={post.data.date}
            heroImage={post.data.hero_image}
            tags={post.data.tags}
            description={post.data.description}
            body={post.body || ''}
          />
        </div>
      ))}
    </div>
  </section>
</Layout>
