---
import ArticleCard from './ArticleCard.astro';
import { postsByDateDesc } from '../lib/content-cache';

interface Props {
  currentSlug: string;
  currentTags: string[];
}

const { currentSlug, currentTags = [] } = Astro.props;

// This component renders on all 1,348 post pages. It previously loaded and
// fully sorted the posts collection on each one; it now reads the shared
// date-sorted index and selects the top 3 in a single linear pass.
//
// Because the source is already newest-first and ties keep the
// earlier-encountered entry, recency remains the tie-break within a score.
const candidates = await postsByDateDesc();
const tagSet = new Set(currentTags);

const top: Array<{ post: (typeof candidates)[number]; score: number }> = [];
for (const post of candidates) {
  if (post.id === currentSlug) continue;
  let score = 0;
  for (const tag of post.data.tags || []) {
    if (tagSet.has(tag)) score++;
  }
  if (top.length < 3) {
    top.push({ post, score });
    top.sort((a, b) => b.score - a.score);
  } else if (score > top[2].score) {
    top[2] = { post, score };
    top.sort((a, b) => b.score - a.score);
  }
}
const scoredPosts = top;
---

{scoredPosts.length > 0 && (
  <section class="mt-16" data-pagefind-ignore="all">
    <h2 class="font-serif text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6">
      Related Articles
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {scoredPosts.map(({ post }) => (
        <ArticleCard
          title={post.data.title}
          slug={post.id}
          date={post.data.date}
          heroImage={post.data.hero_image}
          tags={post.data.tags}
          description={post.data.description}
        />
      ))}
    </div>
  </section>
)}
